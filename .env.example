PORT=3000
# Puerto expuesto por la API ejecutada en Docker. Permite mantener Nest local en 3000.
API_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codequest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codequest

JWT_SECRET=reemplazar-con-un-string-aleatorio-largo
JWT_EXPIRES_IN=7d

DISCORD_CLIENT_ID=tu-discord-client-id
DISCORD_CLIENT_SECRET=tu-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:3000/api/v1/auth/discord/callback
DEVTALLES_GUILD_ID=1130900724499365958

ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Obligatorias: el módulo Devi no deja arrancar la API sin ellas.
OPENAI_API_KEY=tu-openai-api-key
OPENAI_AGENT_ID=tu-openai-agent-id
